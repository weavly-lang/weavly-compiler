// =====================
// Entry / Nodes
// =====================

start: _NEWLINE* (env_block | node)+

// =====================
// Env Block
// =====================

env_block: _ENV _NEWLINE declaration+ _ENDENV _NEWLINE*

?declaration: number_declaration
    | string_declaration
    | flag_declaration
    | extern_declaration
    | pool_declaration
    | slot_declaration

number_declaration: ID _COLON _NUMBER_TYPE ["(" [signed_number] "," [signed_number] ")"] ["=" signed_number] _NEWLINE
string_declaration: ID _COLON _STRING_TYPE ["=" STRING] _NEWLINE
flag_declaration: ID _COLON _FLAG_TYPE ["=" bool_literal] _NEWLINE
extern_declaration: _EXTERN ID _COLON extern_type _NEWLINE
pool_declaration: ID _COLON _POOL_TYPE _NEWLINE
slot_declaration: ID _COLON _SLOT_TYPE _NEWLINE
!extern_type: _NUMBER_TYPE | _STRING_TYPE | _FLAG_TYPE
?bool_literal: TRUE
    | FALSE

node: node_start [meta_block] body node_end
node_start: _NODESTART ID _NEWLINE
node_end: _NODEEND _NEWLINE*

// =====================
// Meta Block
// =====================

meta_block: _META _NEWLINE meta_entry* _ENDMETA _NEWLINE
meta_entry: ID _COLON meta_value ("," meta_value)* _NEWLINE
?meta_value: expression
    | ID

body: statement*

?statement: line_statement
    | block_statement
    | blank_line

?line_statement: narration_line
    | character_line
    | set
    | increase
    | decrease
    | setflag
    | clearflag
    | command
    | goto
    | finish
    | continue

?block_statement: if_block
    | option_block
    | random_block
    | match_block

?inline_statement: _COLON line_statement

inline_goto: _ARROW ID _NEWLINE

action: (inline_statement | inline_goto | _NEWLINE body)

?inline_action: (inline_statement | inline_goto)

// =====================
// Lines / Statements
// =====================

narration_line: TEXT _NEWLINE
character_line: variable _COLON TEXT _NEWLINE
    | _CHARACTER_MARKER CHARACTER_NAME _COLON TEXT _NEWLINE -> named_character_line
blank_line: _NEWLINE

set: _SET variable "=" expression _NEWLINE
increase: _INC variable [signed_number] _NEWLINE
decrease: _DEC variable [signed_number] _NEWLINE
setflag: _SETFLAG variable _NEWLINE
clearflag: _CLEARFLAG variable _NEWLINE

goto: _GOTO ID _NEWLINE

finish: _FINISH _NEWLINE

command: _COMMAND ID [arguments] _NEWLINE

continue: _CONTINUE STRING (inline_action | _NEWLINE) -> continue_

// =====================
// If Block
// =====================

if_block: if_ [elif_list] [else_] _ENDIF _NEWLINE
if_: _IF condition action
elif_: _ELIF condition action
else_: _ELSE action
elif_list: elif_+

// =====================
// Option Block
// =====================

option_block: _OPTIONS _NEWLINE option_item+ _END_OPTIONS _NEWLINE
?option_item: option | hint_option
option: _OPTION [_LBRACKET condition _RBRACKET] STRING action
hint_option: _HINT_OPTION [_LBRACKET condition _RBRACKET] STRING _NEWLINE

// =====================
// Random Block
// =====================

random_block: _RANDOM _NEWLINE case+ _END_RANDOM _NEWLINE
case: _CASE [_LBRACKET condition _RBRACKET] [term] action

// =====================
// Match Block
// =====================

match_block: _MATCH [MATCH_MODIFIER] _NEWLINE when+ _END_MATCH _NEWLINE
when: _WHEN condition action

// =====================
// Expressions
// =====================

condition: expression

?expression: or_expr

?or_expr: and_expr 
    | or_expr _OR and_expr -> or_

?and_expr: not_expr 
    | and_expr _AND not_expr -> and_

?not_expr: _NOT not_expr -> not_
    | comparison
    
?comparison: term
    | term COMP_OP term -> compare

?term: sum

?sum: product
    | sum "+" product -> add
    | sum "-" product -> sub

?product: unary
    | product "*" unary -> mul
    | product "/" unary -> div

?unary: atom
    | "-" unary -> neg

?atom: literal
    | variable
    | node_call
    | call
    | "(" expression ")"

variable: _VARIABLEMARKER ID
node_call: ID "(" ID ")"
call: ID "(" [arguments] ")"
arguments: expression ("," expression)*

interpolation: _LBRACE expression _RBRACE

?signed_number: NUMBER
    | "-" NUMBER -> negative_number
    | "+" NUMBER

?literal: NUMBER
    | STRING
    | TRUE
    | FALSE

// =====================
// Tokens
// =====================

TEXT: /(?![ \t]*[@#$>])[ \t]*\S[^\n]*/
CHARACTER_NAME: /[A-Za-z0-9][A-Za-z0-9 ]*/
COMP_OP: "==" | "!=" | ">" | "<" | ">=" | "<="
TRUE: "true"
FALSE: "false"

_NODESTART: "@node"
_NODEEND: "@endnode"

_ENV: "@env"
_ENDENV: "@endenv"
_NUMBER_TYPE: "number"
_STRING_TYPE: "string"
_FLAG_TYPE: "flag"
_EXTERN: "extern"
_POOL_TYPE: "pool"
_SLOT_TYPE: "slot"

_META: "@meta"
_ENDMETA: "@endmeta"

_SET: "@set"
_INC: "@increase"
_DEC: "@decrease"
_SETFLAG: "@setflag"
_CLEARFLAG: "@clearflag"
_GOTO: "@goto"
_FINISH: "@finish"
_COMMAND: /@(?!(node|endnode|env|endenv|set|increase|decrease|setflag|clearflag|goto|finish|if|elif|else|endif|options|option|hint|endoptions|continue|random|case|endrandom|match|when|endmatch|meta|endmeta)\b)/
_CONTINUE: "@continue"

_IF: "@if"
_ELIF: "@elif"
_ELSE: "@else"
_ENDIF: "@endif"

_OPTIONS: "@options"
_END_OPTIONS: "@endoptions"
_OPTION: "@option"
_HINT_OPTION: "@hint"

_RANDOM: "@random"
_CASE: "@case"
_END_RANDOM: "@endrandom"

_MATCH: "@match"
MATCH_MODIFIER: "first" | "last" | "all"
_WHEN: "@when"
_END_MATCH: "@endmatch"

_NOT: "not"
_AND: "and"
_OR: "or"
_VARIABLEMARKER: "$"
_CHARACTER_MARKER: ">"

_COLON: ":"
_LBRACKET: "["
_RBRACKET: "]"
_ARROW: "->"
_LBRACE: "{"
_RBRACE: "}"

// =====================
// Imports
// =====================

%import common.CNAME -> ID
%import common.NUMBER
%import common.ESCAPED_STRING -> STRING
%import common.WS_INLINE

// =====================
// Ignored
// =====================

// A statement terminator is one or more physical newlines, and it absorbs any
// trailing comments and blank lines. This lets `# ...` sit at the end of a line
// (inline comment) or on its own line inside a block without leaving a stray
// _NEWLINE that block rules like @options/@random/@match can't consume.
COMMENT: /#[^\n]*/
_NEWLINE: ( /\r?\n[\t ]*/ | COMMENT )+
%ignore COMMENT
%ignore WS_INLINE