// =====================
// Entry / Nodes
// =====================

start: _NEWLINE* (env_block | node)*

// =====================
// Env Block
// =====================

env_block: _ENV _NEWLINE declaration+ _ENDENV _NEWLINE*

?declaration: var_declaration
    | extern_declaration
    | pool_declaration
    | slot_declaration
    | meta_declaration
    | function_declaration

var_declaration: _VAR ID _COLON (typed_value | number_range) _NEWLINE
extern_declaration: _EXTERN _VAR ID _COLON (value_type | name_type) _NEWLINE
pool_declaration: _POOL_TYPE ID _NEWLINE
slot_declaration: _SLOT_TYPE ID _NEWLINE
meta_declaration: _META_KEY ID _COLON typed_value _NEWLINE
?typed_value: _NUMBER_TYPE ["=" signed_number] -> number_value
    | _STRING_TYPE ["=" STRING] -> string_value
    | _BOOL_TYPE ["=" bool_literal] -> bool_value
    | name_type "=" ID -> name_value
number_range: _NUMBER_TYPE "(" [signed_number] "," [signed_number] ")" ["=" signed_number]
function_declaration: _FUNC ID "(" [parameters] ")" [_COLON (value_type | name_type)] _NEWLINE
parameters: parameter ("," parameter)*
parameter: ID _COLON (value_type | name_type)
!value_type: _NUMBER_TYPE | _STRING_TYPE | _BOOL_TYPE
!name_type: _NODE_TYPE | _POOL_TYPE | _SLOT_TYPE
?bool_literal: TRUE
    | FALSE

node: node_start [meta_block] body node_end
node_start: _NODESTART ID _NEWLINE
node_end: _NODEEND _NEWLINE*

// =====================
// Meta Block
// =====================

meta_block: _META _NEWLINE meta_entry* _ENDMETA _NEWLINE
meta_entry: ID _COLON expression ("," expression)* _NEWLINE

body: statement*

?statement: line_statement
    | block_statement
    | blank_line

?line_statement: narration_line
    | character_line
    | set
    | increase
    | decrease
    | do
    | jump
    | detour
    | draw
    | finish
    | continue

?block_statement: if_block
    | inline_if
    | option_block
    | random_block
    | match_block

?inline_action: _COLON line_statement

action: inline_action | _NEWLINE body

// =====================
// Lines / Statements
// =====================

narration_line: TEXT _NEWLINE
character_line: variable _COLON TEXT _NEWLINE
    | _CHARACTER_MARKER CHARACTER_NAME _COLON TEXT _NEWLINE -> named_character_line
blank_line: _NEWLINE

set: _SET variable "=" expression _NEWLINE
increase: _INC variable [expression] _NEWLINE
decrease: _DEC variable [expression] _NEWLINE

jump: _JUMP ID _NEWLINE
detour: _DETOUR ID _NEWLINE

draw: _DRAW ID ("," ID)* _NEWLINE

finish: _FINISH _NEWLINE

do: _DO ID "(" [arguments] ")" _NEWLINE

continue: _CONTINUE STRING (inline_action | _NEWLINE) -> continue_

// =====================
// If Block
// =====================

if_block: if_ [elif_list] [else_] _ENDIF _NEWLINE
if_: _IF condition _NEWLINE body
inline_if: _IF condition inline_action
elif_: _ELIF condition action
else_: _ELSE action
elif_list: elif_+

// =====================
// Option Block
// =====================

option_block: _OPTIONS _NEWLINE option_item+ _END_OPTIONS _NEWLINE
?option_item: option | node_option | pool_option
option: _OPTION [_LBRACKET condition _RBRACKET] STRING action
node_option: _OPTION _NODE_TYPE "(" ID ")" _NEWLINE
pool_option: _OPTION _POOL_TYPE "(" pool_argument ("," pool_argument)* ")" _NEWLINE
?pool_argument: ID -> pool_name
    | ID _COLON expression -> pool_parameter

// =====================
// Random Block
// =====================

random_block: _RANDOM _NEWLINE case+ _END_RANDOM _NEWLINE
case: _CASE [_LBRACKET condition _RBRACKET] [term] action

// =====================
// Match Block
// =====================

match_block: _MATCH [MATCH_MODIFIER] _NEWLINE when+ _END_MATCH _NEWLINE
when: _WHEN condition action

// =====================
// Expressions
// =====================

condition: expression

?expression: or_expr

?or_expr: and_expr 
    | or_expr _OR and_expr -> or_

?and_expr: not_expr 
    | and_expr _AND not_expr -> and_

?not_expr: _NOT not_expr -> not_
    | comparison
    
?comparison: term
    | term COMP_OP term -> compare

?term: sum

?sum: product
    | sum "+" product -> add
    | sum "-" product -> sub

?product: unary
    | product "*" unary -> mul
    | product "/" unary -> div

?unary: atom
    | "-" unary -> neg

?atom: literal
    | variable
    | call
    | meta_read
    | ID -> name
    | "(" expression ")"

variable: _VARIABLEMARKER ID
call: ID "(" [arguments] ")"
meta_read: META_READ
arguments: expression ("," expression)*

interpolation: _LBRACE expression _RBRACE

?signed_number: NUMBER
    | "-" NUMBER -> negative_number
    | "+" NUMBER

?literal: NUMBER
    | STRING
    | TRUE
    | FALSE

// =====================
// Tokens
// =====================

TEXT: /(?![ \t]*[@#$>])[ \t]*\S[^\n]*/
CHARACTER_NAME: /[A-Za-z0-9][A-Za-z0-9 ]*/
COMP_OP: "==" | "!=" | ">" | "<" | ">=" | "<="
META_READ.2: /([A-Za-z_][A-Za-z0-9_]*)?\.[A-Za-z_][A-Za-z0-9_]*/
TRUE: "true"
FALSE: "false"

_NODESTART: /@node\b/
_NODEEND: /@endnode\b/

_ENV: /@env\b/
_ENDENV: /@endenv\b/
_NUMBER_TYPE: "number"
_STRING_TYPE: "string"
_BOOL_TYPE: "bool"
_VAR: "var"
_EXTERN: "extern"
_NODE_TYPE: "node"
_POOL_TYPE: "pool"
_SLOT_TYPE: "slot"
_META_KEY: "meta"
_FUNC: "func"

_META: /@meta\b/
_ENDMETA: /@endmeta\b/

_SET: /@set\b/
_INC: /@increase\b/
_DEC: /@decrease\b/
_JUMP: /@jump\b/
_DETOUR: /@detour\b/
_DRAW: /@draw\b/
_FINISH: /@finish\b/
_DO: /@do\b/
_CONTINUE: /@continue\b/

_IF: /@if\b/
_ELIF: /@elif\b/
_ELSE: /@else\b/
_ENDIF: /@endif\b/

_OPTIONS: /@options\b/
_END_OPTIONS: /@endoptions\b/
_OPTION: /@option\b/

_RANDOM: /@random\b/
_CASE: /@case\b/
_END_RANDOM: /@endrandom\b/

_MATCH: /@match\b/
MATCH_MODIFIER: "first" | "last" | "all"
_WHEN: /@when\b/
_END_MATCH: /@endmatch\b/

_NOT: "not"
_AND: "and"
_OR: "or"
_VARIABLEMARKER: "$"
_CHARACTER_MARKER: ">"

_COLON: ":"
_LBRACKET: "["
_RBRACKET: "]"
_LBRACE: "{"
_RBRACE: "}"

// =====================
// Imports
// =====================

%import common.CNAME -> ID
%import common.NUMBER
%import common.ESCAPED_STRING -> STRING
%import common.WS_INLINE

// =====================
// Ignored
// =====================

// A statement terminator is one or more physical newlines, and it absorbs any
// trailing comments and blank lines. This lets `# ...` sit at the end of a line
// (inline comment) or on its own line inside a block without leaving a stray
// _NEWLINE that block rules like @options/@random/@match can't consume.
COMMENT: /#[^\n]*/
_NEWLINE: ( /\r?\n[\t ]*/ | COMMENT )+
%ignore COMMENT
%ignore WS_INLINE