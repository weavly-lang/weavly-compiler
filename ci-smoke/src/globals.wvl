@env
var score: number = 0
var player_name: string = "Hero"
var has_key: bool = false
extern var reputation: number
var region: pool = cave_outcome
var last_scene: node = Start
pool cave_outcome
slot treasure
character Guide
var companion: character = Guide
meta reward: number = 1
func luck(): number
func play_sound(file: string, volume: number)
func fade_out()
func add_bonus(target: var number, amount: number)
@endenv
