@node start
Welcome to the smoke test.
>Guide: Let the test begin.
@detour aside
@do play_sound("chime.ogg", clamp($score / 10, 0, 1))
@set $score = 10
@increase $score 5
@decrease $score 2
@set $score = clamp($score + random(1, 6), 0, 100)
@set $score = round(max(min($score, 50), abs($score - 20)) / 2)
@setflag $has_key
@clearflag $has_key

@if $score > 10
    @jump choices
@elif $score == 10
    @jump choices
@else
    @jump choices
@endif
@endnode

@node choices
$player_name: Which path? I have {$score * 2} points and {max($reputation, 0)} fame.

@options
@option "Roll the dice" -> random_node
@option "Explore the cave": @draw cave_outcome
@option [ $has_key ] "Use key on door \{{visit_count(choices)}}" -> end
@option node(aside)
@option pool(cave_outcome, limit: 1, locked: extra)
@endoptions
@endnode

@node random_node
@random
@case 1: @jump match_node
@case 1: @jump match_node
@endrandom
@endnode

@node match_node
@match
    @when $has_key
        You have the key.
        @jump end
    @when not $has_key
        No key needed.
        @draw cave_outcome
        @jump end
@endmatch
@endnode

@node end
@set $score = visit_count(choices)
@set $last_scene = end
@if $region == cave_outcome and $last_scene != start
    You came back from the cave.
@endif
@if visited(start) and not visited(end)
    Thanks for playing, {$player_name}. Final score: {round($score)}.
@endif
@if $reputation > 100
    Everyone knows you.
@endif
@if luck() > 5
    Lucky you.
@endif
@do luck()
@do fade_out()
@finish
@endnode

@node cave_treasure
@meta
pool: cave_outcome
slot: treasure
when: $score > 5
priority: 1
weight: 1 + skip_count()
once: true
reward: 2 + skip_count()
label: "Open the chest ({.reward} points)"
label_unavailable: "The chest is locked"
available: $has_key
@endmeta
You find a chest.
@set $score = $score + .reward
@jump end
@endnode

@node aside
@meta
label: "Take a quick aside"
@endmeta
A quick aside before we start.
@endnode

@node cave_gold
@meta
pool: cave_outcome
slot: treasure
label: "Grab the gold"
@endmeta
Gold glitters in the dark.
@endnode
