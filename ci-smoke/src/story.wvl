@node start
Welcome to the smoke test.
>Guide: Let the test begin.
@play_sound "chime.ogg", clamp($score / 10, 0, 1)
@set $score = 10
@increase $score 5
@decrease $score 2
@set $score = clamp($score + random(1, 6), 0, 100)
@set $score = round(max(min($score, 50), abs($score - 20)) / 2)
@setflag $has_key
@clearflag $has_key

@if $score > 10
    @goto choices
@elif $score == 10
    @goto choices
@else
    @goto choices
@endif
@endnode

@node choices
$player_name: Which path? I have {$score * 2} points and {max($reputation, 0)} fame.

@options
@option "Roll the dice" -> random_node
@option [ $has_key ] "Use key on door \{{visit_count(choices)}}" -> end
@endoptions
@endnode

@node random_node
@random
@case 1: @goto match_node
@case 1: @goto match_node
@endrandom
@endnode

@node match_node
@match
    @when $has_key
        You have the key.
        @goto end
    @when not $has_key
        No key needed.
        @goto end
@endmatch
@endnode

@node end
@set $score = visit_count(choices)
@if visited(start) and not visited(end)
    Thanks for playing, {$player_name}. Final score: {round($score)}.
@endif
@if $reputation > 100
    Everyone knows you.
@endif
@fade_out
@finish
@endnode
